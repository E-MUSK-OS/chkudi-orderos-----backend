generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                        String                    @id @default(cuid())
  fullName                  String
  email                     String                    @unique
  password                  String
  role                      Role                      @default(USER)
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  username                  String                    @unique
  isActive                  Boolean                   @default(true)
  isVerified                Boolean                   @default(false)
  phone                     String?                   @db.VarChar(20)
  isLocked                  Boolean                   @default(false)
  gender                    String?
  department                String?
  company                   String?
  rights                    String?
  avatar                    String?
  ownerId                   String?
  createdById               String?
  lockedAt                  DateTime?
  lockedReason              DateTime?
  allowedPages              String[]                  @default([])
  companies                 String[]                  @default([])
  departments               String[]                  @default([])
  dob                       DateTime?
  firstName                 String?
  lastName                  String?
  middleName                String?
  accounts                  Account[]
  adminMappings             AdminUserMapping[]        @relation("AdminManagedUsers")
  superAdminMappings        AdminUserMapping[]        @relation("SuperAdminManagedUsers")
  userMapping               AdminUserMapping?         @relation("UserManagedByAdmin")
  asinImports               AsinImport[]
  dropdownOptions           DropdownOption[]
  labelTemplates            LabelTemplate[]
  marketplaceAccounts       MarketplaceAccount[]
  notifications             Notification[]
  operators                 Operator[]
  orders                    Order[]
  parties                   Party[]
  products                  Product[]
  materials                 Material[]
  productInventories        ProductInventory[]
  purchaseChallans          PurchaseChallan[]
  purchaseInvoices          PurchaseInvoice[]
  refreshTokens             RefreshToken[]
  salesChallans             SalesChallan[]
  salesInvoices             SalesInvoice[]
  sheetDrafts               SheetDraft[]
  skuMappings               SkuMapping[]
  stockTransfers            StockTransfer[]
  tags                      Tag[]
  tagLoops                  TagLoop[]
  vmsscans                  VMSScan[]
  wallet                    Wallet?
  warehouses                Warehouse[]
  webstores                 Webstore[]
  amazonAnalytics           AmazonAnalytics[]
  amazonAnalyticsHistory    AmazonAnalyticsHistory[]
  amazonAnalyticsSetting    AmazonAnalyticsSetting?
  amazonDailyOrderSummaries AmazonDailyOrderSummary[]
  amazonOrders              AmazonOrder[]
  amazonProcessBatches      AmazonProcessBatch[]
  myntraImports             MyntraImport[]
  companyEntities Company[] @relation("UserCompanyEntities")
  employees Employee[]
  clientConfiguration ClientConfiguration? @relation("WorkspaceClientConfig")

  @@index([createdById])
  @@index([ownerId])
}

model AdminUserMapping {
  id            String   @id @default(cuid())
  superAdminId  String?
  adminId       String?
  userId        String   @unique
  allowedPages  String[] @default([])
  departments   String[] @default([])
  companies     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  superAdmin    User?    @relation("SuperAdminManagedUsers", fields: [superAdminId], references: [id], onDelete: SetNull)
  admin         User?    @relation("AdminManagedUsers", fields: [adminId], references: [id], onDelete: Cascade)
  user          User     @relation("UserManagedByAdmin", fields: [userId], references: [id], onDelete: Cascade)

  @@index([superAdminId])
  @@index([adminId])
  @@index([userId])
}

model EmailOtp {
  id        String     @id @default(cuid())
  email     String
  otp       String     @db.VarChar(6)
  purpose   OtpPurpose
  expiresAt DateTime
  verified  Boolean    @default(false)
  createdAt DateTime   @default(now())
}

model VMSScan {
  id                String    @id @default(cuid())
  trackingId        String
  videoUrl          String?
  thumbnailUrl      String?
  status            String    @default("PENDING")
  fileName          String?
  fileSize          Int?
  duration          Int?
  cameraName        String?
  uploadedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  publicId          String?
  version           Int?
  userId            String
  operatorId        String?
  accountId         String?
  packingScanStatus String    @default("PENDING")
  filePath          String?
  thumbnailPath     String?
  account           Account?  @relation(fields: [accountId], references: [id])
  operator          Operator? @relation(fields: [operatorId], references: [id])
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([trackingId])
  @@index([status])
  @@index([userId])
  @@index([operatorId])
  @@index([accountId])
}

model Operator {
  id           String    @id @default(cuid())
  operatorName String
  employeeCode String    @unique
  isActive     Boolean   @default(true)
  userId       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  password     String
  isLoggedIn   Boolean   @default(false)
  lastSeen     DateTime?
  sessionId    String?
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scans        VMSScan[]

  @@index([userId])
}

model Account {
  id          String    @id @default(cuid())
  accountName String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vmsscans    VMSScan[]

  @@index([userId])
}

model Wallet {
  id           String              @id @default(cuid())
  userId       String              @unique
  points       Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  type         WalletTransactionType
  points       Int
  balanceAfter Int
  description  String?
  referenceId  String?
  createdAt    DateTime              @default(now())
  wallet       Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

model TagLoop {
  id          String   @id @default(cuid())
  startTag    String
  endTag      String
  total       Int
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  endNumber   Int
  prefix      String
  startNumber Int
  notify0     Boolean  @default(false)
  notify10    Boolean  @default(false)
  notify30    Boolean  @default(false)
  notify50    Boolean  @default(false)
  tags        Tag[]
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
}

model Tag {
  id          String    @id @default(cuid())
  tagNumber   String
  status      TagStatus @default(AVAILABLE)
  loopId      String
  orderItemId String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  userId      String
  orderId     String?
  loop        TagLoop   @relation(fields: [loopId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tagNumber])
  @@index([status])
  @@index([loopId])
}

model Notification {
  id          String               @id @default(cuid())
  title       String
  message     String
  type        NotificationType
  priority    NotificationPriority @default(MEDIUM)
  entityId    String?
  entityType  String?
  readAt      DateTime?
  userId      String
  createdAt   DateTime             @default(now())
  dismissedAt DateTime?
  status      NotificationStatus   @default(UNREAD)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model Warehouse {
  id            String             @id @default(cuid())
  warehouseName String
  warehouseCode String
  description   String?
  isDefault     Boolean            @default(false)
  isActive      Boolean            @default(true)
  contactPerson String?
  phone         String?            @db.VarChar(20)
  email         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  gstNumber     String?
  userId        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  inventories   ProductInventory[]
  transferFrom  StockTransfer[]    @relation("TransferFrom")
  transferTo    StockTransfer[]    @relation("TransferTo")
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, warehouseCode])
  @@unique([userId, warehouseName])
  @@index([userId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String
  status          TransferStatus      @default(PENDING)
  notes           String?
  fromWarehouseId String
  toWarehouseId   String
  userId          String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  fromWarehouse   Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           StockTransferItem[]

  @@unique([userId, transferNumber])
  @@index([userId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferItem {
  id               String         @id @default(cuid())
  transferId       String
  productVariantId String
  quantity         Int
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  transfer         StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productVariantId])
}

model Product {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  productName String
  masterSku   String
  sku         String?

  brand       String?
  category    String
  subCategory String?

  description String?

  unit            String?  @default("Pcs")
  sizeList        String?
  colors          String[] @default([])
  gender          String?
  referenceParty  String?
  marketplace     String?  @default("All")

  productCost       Float?   @default(0)
  dealerRate        Float?   @default(0)
  retailRate        Float?   @default(0)
  openingStock      Int?     @default(0)
  reorderLevelStock Int?     @default(0)
  minimumStock      Int?     @default(0)
  productPoints     Float?   @default(1)
  isPaired          Boolean  @default(false)
  availability      String?  @default("Public")

  asin            String?
  myntraSku       String?
  fsnCode         String?
  rackAddress     String?
  generateBarcode String?  @default("No")
  mrp             String?
  mfgMonth        String?
  hsnCode         String?
  gstRate         Float?
  imageUrl        String?

  imgfileurl      String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  // ======================================================
  // Relations
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attributes ProductAttribute[]

  variants ProductVariant[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, masterSku])

  @@index([userId])
  @@index([category])
  @@index([brand])
  @@index([asin])
}

model ProductAttribute {
  id                String                    @id @default(cuid())
  attributeName     String
  productId         String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  product           Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantAttributes ProductVariantAttribute[]

  @@unique([productId, attributeName])
  @@index([productId])
}

model ProductVariant {
  id                 String                    @id @default(cuid())
  variantSku         String
  isActive           Boolean                   @default(true)
  productId          String
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  asin               String?
  myntraSku          String?
  fsnCode            String?
  rackAddress        String?
  generateBarcode    String?                   @default("No")
  imageUrl           String?
  imgfileurl         String?
  orderItems         OrderItem[]
  inventories        ProductInventory[]
  product            Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributes         ProductVariantAttribute[]
  stockTransferItems StockTransferItem[]

  @@unique([productId, variantSku])
  @@index([productId])
}

model ProductVariantAttribute {
  id                 String           @id @default(cuid())
  attributeValue     String
  productVariantId   String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  productAttributeId String
  productAttribute   ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)
  productVariant     ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, productAttributeId])
  @@index([productVariantId])
  @@index([productAttributeId])
}

// ==================================================================================
// ====================================== MATERIAL MODEL =============================
// ==================================================================================

model Material {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  materialName String
  masterSku    String
  sku          String?

  brand              String?
  category           String
  manufacturingGroup String?
  subCategory        String?
  forUse             String?

  description String?

  unit           String?
  sizeList       String?
  colors         String[]
  width          Float?   @default(0)
  widthRangeFrom Float?   @default(0)
  widthRangeTo   Float?   @default(0)
  gsm            Float?   @default(0)
  gsmRangeFrom   Float?   @default(0)
  gsmRangeTo     Float?   @default(0)
  ledgerGroup    String?  @default("Material Purchase")
  less           Float?   @default(0)
  gender         String?
  referenceParty String?
  marketplace    String?  @default("All")

  costApplyingMode         String?
  materialCost             Float?
  salesRate                Float?   @default(0)
  purchaseType             String?
  isStockDetailsCompulsory Boolean  @default(false)
  issueMode                String?
  consumptionMode          String?
  isIssuable               Boolean  @default(false)
  isSellable               Boolean  @default(false)

  dealerRate        Float?
  retailRate        Float?
  openingStock      Int?
  reorderLevelStock Int?
  minimumStock      Int?
  materialPoints    Float?
  isPaired          Boolean @default(false)
  availability      String?

  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  mrp             String?
  mfgMonth        String?
  hsnCode         String?
  gstRate         Float?
  imageUrl        String?

  imgfileurl      String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  // ======================================================
  // Relations
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attributes MaterialAttribute[]

  variants MaterialVariant[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, masterSku])
  @@unique([userId, materialName])
  @@index([userId])
  @@index([category])
  @@index([brand])
  @@index([asin])
}

model MaterialAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Attribute
  // ======================================================

  attributeName String

  // ======================================================
  // Relation
  // ======================================================

  materialId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  variantAttributes MaterialVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, attributeName])
  @@index([materialId])
}

// ==================================================================================
// =============================== MATERIAL VARIANT MODEL ============================
// ==================================================================================

model MaterialVariant {
  id String @id @default(cuid())

  // ======================================================
  // Variant
  // ======================================================

  variantSku      String
  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  imageUrl        String?

  imgfileurl      String?

  isActive Boolean @default(true)

  // ======================================================
  // Relation
  // ======================================================

  materialId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  attributes MaterialVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, variantSku])
  @@index([materialId])
}

// ==================================================================================
// ========================= MATERIAL VARIANT ATTRIBUTE MODEL ========================
// ==================================================================================

model MaterialVariantAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Value
  // ======================================================

  attributeValue String

  // ======================================================
  // Relations
  // ======================================================

  materialVariantId String

  materialVariant MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Cascade)

  materialAttributeId String

  materialAttribute MaterialAttribute @relation(fields: [materialAttributeId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialVariantId, materialAttributeId])
  @@index([materialVariantId])
  @@index([materialAttributeId])
}

model ProductInventory {
  id                    String         @id @default(cuid())
  productVariantId      String
  userId                String
  availableStock        Int            @default(0)
  reservedStock         Int            @default(0)
  damagedStock          Int            @default(0)
  incomingStock         Int            @default(0)
  reorderLevel          Int            @default(10)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  lastNotificationLevel Int?
  warehouseId           String
  productVariant        ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse             Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, warehouseId])
  @@index([userId])
  @@index([availableStock])
}

model SkuMapping {
  id           String   @id @default(cuid())
  userId       String
  shortSku     String
  barcodeSku   String
  ordercookSku String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  brandName    String?
  asinBarcode  String?
  color        String?
  size         String?
  fullSku      String?
  title        String?
  qty          Int?
  mrp          String?
  mfgMonth     String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shortSku])
  @@index([userId])
  @@index([shortSku])
}

model SheetDraft {
  id        String   @id @default(cuid())
  userId    String
  rows      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

model Marketplace {
  id                  String               @id @default(cuid())
  marketplaceName     String
  marketplaceCode     String               @unique
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  displayOrder        Int                  @default(0)
  marketplaceAccounts MarketplaceAccount[] @relation("MarketplaceToAccount")

  @@index([marketplaceCode])
}

model MarketplaceAccount {
  id               String                      @id @default(cuid())
  userId           String
  marketplaceId    String
  sellerName       String                      @db.VarChar(150)
  sellerCode       String                      @db.VarChar(100)
  displayName      String?
  isActive         Boolean                     @default(true)
  connectionStatus MarketplaceConnectionStatus @default(NOT_CONNECTED)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  marketplace      Marketplace                 @relation("MarketplaceToAccount", fields: [marketplaceId], references: [id])
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection       MarketplaceConnection?
  orders           Order[]

  @@unique([userId, marketplaceId, sellerCode])
  @@index([userId])
  @@index([marketplaceId])
}

model MarketplaceConnection {
  id                   String                      @id @default(cuid())
  marketplaceAccountId String                      @unique
  credentials          Json
  environment          MarketplaceEnvironment      @default(PRODUCTION)
  status               MarketplaceConnectionStatus @default(NOT_CONNECTED)
  lastConnectedAt      DateTime?
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  marketplaceAccount   MarketplaceAccount          @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)
}

model Order {
  id                   String              @id @default(cuid())
  orderNumber          String
  channelOrderId       String?
  userId               String
  marketplaceAccountId String?
  customerName         String
  customerEmail        String?
  customerPhone        String?             @db.VarChar(20)
  shippingAddress      String?
  status               OrderStatus         @default(PENDING)
  paymentStatus        PaymentStatus       @default(PENDING)
  paymentMethod        String?
  totalAmount          Float               @default(0)
  shippingAmount       Float               @default(0)
  discountAmount       Float               @default(0)
  courierName          String?
  trackingId           String?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id])
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items                OrderItem[]

  @@unique([userId, orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([channelOrderId])
  @@index([trackingId])
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productVariantId String?
  productName      String
  sku              String
  quantity         Int             @default(1)
  unitPrice        Float           @default(0)
  totalPrice       Float           @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@index([sku])
}

model LabelTemplate {
  id                 String   @id @default(cuid())
  userId             String
  marketplaceId      String?
  name               String
  backgroundImageUrl String?
  layoutJson         Json
  settings           Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  thumbnailUrl       String?
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AsinImport {
  id              String   @id @default(cuid())
  asin            String
  sku             String
  generateBarcode String?
  rackAddress     String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([asin])
  @@index([sku])
}

model MyntraImport {
  id              String   @id @default(cuid())
  rackAddress     String?
  myntraSku       String
  sellerSku       String?
  generateBarcode String?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([myntraSku])
  @@index([sellerSku])
  @@index([generateBarcode])
  @@map("myntra_imports")
}

model AmazonOrder {
  id                String              @id @default(cuid())
  invoice           String
  orderId           String
  awb               String
  asin              String
  sellerSku         String
  customer          String
  packingScanStatus String              @default("PENDING")
  userId            String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  expiresAt         DateTime
  batchId           String?
  batch             AmazonProcessBatch? @relation(fields: [batchId], references: [id])
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([batchId])
  @@index([orderId])
  @@index([awb])
  @@index([packingScanStatus])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("amazon_orders")
}

model AmazonProcessBatch {
  id                  String        @id @default(cuid())
  batchNumber         String?
  batchDate           DateTime
  totalOrders         Int           @default(0)
  matchedCount        Int           @default(0)
  mismatchCount       Int           @default(0)
  matchPercentage     Float         @default(0)
  pdfFileName         String?
