generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================================
// ================================ RefreshToken MODEL ==============================
// ==================================================================================

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

// ==================================================================================
// ====================================== USER MODEL ================================
// ==================================================================================

model User {
  id String @id @default(cuid())

  fullName String
  username String @unique
  email    String @unique
  password String

  phone String? @db.VarChar(20)

  role Role @default(USER)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  refreshTokens      RefreshToken[]
  vmsscans           VMSScan[]
  operators          Operator[]
  accounts           Account[]
  wallet             Wallet?
  tagLoops           TagLoop[]
  tags               Tag[]
  notifications      Notification[]
  warehouses         Warehouse[]
  products           Product[]
  productInventories ProductInventory[]
}

enum Role {
  USER
  ADMIN
}

// ==================================================================================
// ================================ EMAIL OTP MODEL =================================
// ==================================================================================

model EmailOtp {
  id String @id @default(cuid())

  email String
  otp   String @db.VarChar(6)

  purpose OtpPurpose

  expiresAt DateTime

  verified Boolean @default(false)

  createdAt DateTime @default(now())
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  FORGOT_PASSWORD
}

// ==================================================================================
// ====================================== VMS MODEL =================================
// ==================================================================================

model VMSScan {
  id String @id @default(cuid())

  trackingId String

  videoUrl     String?
  thumbnailUrl String?

  publicId String?
  version  Int?

  status            String @default("PENDING")
  packingScanStatus String @default("PENDING")

  fileName String?
  fileSize Int?

  duration Int?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  operatorId String?

  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  accountId String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  cameraName String?

  uploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([userId])
  @@index([operatorId])
  @@index([accountId])
}

enum ScanStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

// ==================================================================================
// ====================================== Operator MODEL ============================
// ==================================================================================

model Operator {
  id String @id @default(cuid())

  operatorName String

  employeeCode String @unique

  password String

  isActive Boolean @default(true)

  isLoggedIn Boolean @default(false)

  sessionId String?

  lastSeen DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scans VMSScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================================================================================
// ====================================== Account MODEL =============================
// ==================================================================================

model Account {
  id String @id @default(cuid())

  accountName String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vmsscans  VMSScan[]

  @@index([userId])
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique

  points Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type WalletTransactionType

  points Int

  balanceAfter Int

  description String?

  referenceId String?

  createdAt DateTime @default(now())

  @@index([walletId])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

// ==================================================================================
// ====================================== TAG LOOP MODEL ============================
// ==================================================================================

model TagLoop {
  id String @id @default(cuid())

  prefix String

  startTag String
  endTag   String

  startNumber Int
  endNumber   Int

  total Int

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags Tag[]

  notify50 Boolean @default(false)

  notify30 Boolean @default(false)

  notify10 Boolean @default(false)

  notify0 Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([prefix])
}

// ==================================================================================
// ========================================= TAG MODEL ==============================
// ==================================================================================

model Tag {
  id String @id @default(cuid())

  tagNumber String

  status TagStatus @default(AVAILABLE)

  loopId String

  loop TagLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItemId String?

  usedAt DateTime?

  orderId String?

  createdAt DateTime @default(now())

  @@unique([userId, tagNumber])
  @@index([status])
  @@index([loopId])
}

enum TagStatus {
  AVAILABLE
  USED
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  type NotificationType

  priority NotificationPriority @default(MEDIUM)

  entityId String?

  entityType String?

  status NotificationStatus @default(UNREAD)

  dismissedAt DateTime?

  readAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  // @@index([isRead])
  @@index([type])
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum NotificationType {
  TAG_LOOP
  ORDER
  WALLET
  VMS
  INVENTORY
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==================================================================================
// ====================================== Warehouse MODEL ===========================
// ==================================================================================

model Warehouse {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  warehouseName String
  warehouseCode String

  description String?

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  // ======================================================
  // Contact
  // ======================================================

  contactPerson String?

  phone String? @db.VarChar(20)

  email String?

  // ======================================================
  // Address
  // ======================================================

  addressLine1 String?

  addressLine2 String?

  city String?

  state String?

  country String?

  pincode String?

  // ======================================================
  // Business
  // ======================================================

  gstNumber String?

  // ======================================================
  // Relation
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  inventories ProductInventory[]

  @@unique([userId, warehouseCode])
  @@unique([userId, warehouseName])
  @@index([userId])
}

// ==================================================================================
// ====================================== PRODUCT MODEL =============================
// ==================================================================================

model Product {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  productName String
  masterSku   String

  brand       String?
  category    String
  subCategory String?

  description String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  // ======================================================
  // Relations
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attributes ProductAttribute[]

  variants ProductVariant[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, masterSku])
  @@unique([userId, productName])
  @@index([userId])
  @@index([category])
  @@index([brand])
}

model ProductAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Attribute
  // ======================================================

  attributeName String

  // ======================================================
  // Relation
  // ======================================================

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantAttributes ProductVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeName])
  @@index([productId])
}

// ==================================================================================
// =============================== PRODUCT VARIANT MODEL ============================
// ==================================================================================

model ProductVariant {
  id String @id @default(cuid())

  // ======================================================
  // Variant
  // ======================================================

  variantSku String

  isActive Boolean @default(true)

  // ======================================================
  // Relation
  // ======================================================

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes ProductVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  // inventory ProductInventory?
  inventories ProductInventory[]

  @@unique([productId, variantSku])
  @@index([productId])
}

// ==================================================================================
// ========================= PRODUCT VARIANT ATTRIBUTE MODEL ========================
// ==================================================================================

model ProductVariantAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Value
  // ======================================================

  attributeValue String

  // ======================================================
  // Relations
  // ======================================================

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  productAttributeId String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, productAttributeId])
  @@index([productVariantId])
  @@index([productAttributeId])
}

model ProductInventory {
  id String @id @default(cuid())

  // ======================================================
  // Relations
  // ======================================================

  // productVariantId String @unique
  productVariantId String
  warehouseId      String
  userId           String

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Stock
  // ======================================================

  availableStock Int @default(0)
  reservedStock  Int @default(0)
  damagedStock   Int @default(0)
  incomingStock  Int @default(0)
  reorderLevel   Int @default(10)

  // ===============================
  // Notification Flags
  // ===============================

  // lowStock25Notified Boolean @default(false)

  // lowStock10Notified Boolean @default(false)

  // outOfStockNotified Boolean @default(false)
  lastNotificationLevel Int?

  // ======================================================
  // System
  // ======================================================

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  // warehouseId String?

  @@unique([productVariantId, warehouseId])
  @@index([userId])
  @@index([availableStock])
}
