// ==================================================================================
// ============================= PARTY / LEDGER BOOK MODEL ==========================
// ==================================================================================

model Party {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyName      String
  accountCode    String?
  alias          String?
  accountHead    String         @default("Sundry Debtors")
  contactPerson  String?
  email          String?
  phone          String?
  whatsapp       String?
  addressLine1          String?
  addressLine2          String?
  addressLine3          String?
  area                  String?
  city                  String?
  state                 String?
  country               String?        @default("India")
  pincode               String?

  // Shipping Address
  shippingSameAsBilling Boolean        @default(true)
  shippingAddress1      String?
  shippingAddress2      String?
  shippingAddress3      String?
  shippingArea          String?
  shippingCountry       String?        @default("India")
  shippingState         String?
  shippingCity          String?
  shippingPincode       String?
  shippingPhone         String?

  // Accounting Details
  pan                   String?
  gstin                 String?
  gstDate               String?
  cstNo                 String?
  cstDate               String?
  serviceTaxNo          String?
  serviceTaxDate        String?
  otherTaxNo            String?
  otherTaxDate          String?
  billDueDays           Int            @default(0)
  creditLimit           Float          @default(0)
  debitLimit            Float          @default(0)

  bankName              String?
  accountNumber         String?
  ifsc                  String?
  accountHolderName     String?
  branchName            String?
  accountType           String?        @default("Current")

  // Additional Legal & Ledger Book Details
  legalName             String?
  msmeNumber            String?
  creditDebitLimit      Float          @default(0)
  refContactName        String?
  logoUrl               String?
  completionPercentage  Int?           @default(0)
  createdByName         String?
  updatedByName         String?

  openingBalance        Float          @default(0)
  balanceType           String         @default("Credit")
  joinDate              DateTime       @default(now())
  isActive              Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  challans          SalesChallan[]
  purchaseChallans  PurchaseChallan[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]

  @@unique([userId, partyName])
  @@index([userId])
  @@index([partyName])
  @@index([accountHead])
}

// ==================================================================================
// ============================== SALES CHALLAN MODEL ===============================
// ==================================================================================

model SalesChallan {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyId       String?
  party         Party?             @relation(fields: [partyId], references: [id], onDelete: SetNull)
  partyName     String
  contactNo     String?
  challanNo     String
  challanRefNo  String?
  challanDate   DateTime           @default(now())
  challanFor    String             @default("Sales")
  stockOutFrom  String             @default("General")
  consigneeName String?            @default("Not Applicable")
  deliveryBy    String?            @default("Buyer")
  preparedBy    String?
  deliveryTerms String?
  totalQuantity Int                @default(0)
  totalAmount   Float              @default(0)
  invoiceStatus String             @default("Not Invoiced")
  isStockOut    Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  items         SalesChallanItem[]
  invoices      SalesInvoice[]

  @@unique([userId, challanNo])
  @@index([userId])
  @@index([challanNo])
  @@index([challanDate])
}

// ==================================================================================
// ============================ SALES CHALLAN ITEM MODEL ============================
// ==================================================================================

model SalesChallanItem {
  id           String       @id @default(cuid())
  challanId    String
  challan      SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  itemNo       Int          @default(1)
  sku          String
  name         String
  quantity     Int          @default(1)
  rate         Float        @default(0.0)
  amount       Float        @default(0.0)
  dispatchDate String?
  subCn        String?
  remarks      String?
  printBarcode Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([challanId])
  @@index([sku])
}

// ==================================================================================
// ============================= PURCHASE CHALLAN MODEL =============================
