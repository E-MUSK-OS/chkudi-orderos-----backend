// ==================================================================================
// ============================= AMAZON ORDER MODEL =================================
// ==================================================================================

model AmazonOrder {
  id String @id @default(cuid())

  invoice   String // Invoices
  orderId   String // Amazon Order ID
  awb       String // AWB Tracking
  asin      String // ASIN
  sellerSku String // Seller SKU
  customer  String // Customer

  packingScanStatus String @default("PENDING") // "PENDING" or "SCANNED"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  batchId String?
  batch   AmazonProcessBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 7 days expiration timestamp

  @@index([userId])
  @@index([batchId])
  @@index([orderId])
  @@index([awb])
  @@index([packingScanStatus])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("amazon_orders")
}

// ==================================================================================
// ========================= AMAZON PROCESS BATCH MODEL ==============================
// ==================================================================================

model AmazonProcessBatch {
  id String @id @default(cuid())

  batchNumber String?
  batchDate   DateTime // Date of the batch

  totalOrders     Int   @default(0)
  matchedCount    Int   @default(0)
  mismatchCount   Int   @default(0)
  matchPercentage Float @default(0)

  pdfFileName String?
  zplFileName String?

  summary Json // AmazonOrderSummary object
  results Json // AmazonComparisonResult[] array (matched & comparison order records)

  // Document URLs and relative file paths
  combinedPdfPath     String?
  combinedPdfUrl      String?
  zplPdfPath          String?
  zplPdfUrl           String?
  originalPdfPath     String?
  originalPdfUrl      String?
  unmatchedPdfPath    String?
  unmatchedPdfUrl     String?
  unmatchedZplPdfPath String?
  unmatchedZplPdfUrl  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  amazonOrders AmazonOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 6:00 PM on the 7th day

  @@index([userId])
  @@index([batchDate])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("amazon_process_batches")
}

// ==================================================================================
// ==================== AMAZON DAILY ORDER SUMMARY MODEL ===========================
// ==================================================================================

model AmazonDailyOrderSummary {
  id String @id @default(cuid())

  date String // "YYYY-MM-DD" strictly in IST (Asia/Kolkata), e.g., "2026-10-24"

  totalOrders   Int @default(0) // Total processed/printed orders for this day
  scannedOrders Int @default(0) // Orders verified via AWB packing scan
  pendingOrders Int @default(0) // Orders pending packing scan

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("amazon_daily_order_summaries")
}

// ==================================================================================
