generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================================
// ================================ RefreshToken MODEL ==============================
// ==================================================================================

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

// ==================================================================================
// ====================================== USER MODEL ================================
// ==================================================================================

model User {
  id String @id @default(cuid())

  fullName String
  username String @unique
  email    String @unique
  password String

  phone String? @db.VarChar(20)

  role Role @default(USER)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  vmsscans      VMSScan[]
  operators     Operator[]
  accounts      Account[]
  wallet        Wallet?
  tagLoops      TagLoop[]
  tags          Tag[]
}

enum Role {
  USER
  ADMIN
}

// ==================================================================================
// ================================ EMAIL OTP MODEL =================================
// ==================================================================================

model EmailOtp {
  id String @id @default(cuid())

  email String
  otp   String @db.VarChar(6)

  purpose OtpPurpose

  expiresAt DateTime

  verified Boolean @default(false)

  createdAt DateTime @default(now())
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  FORGOT_PASSWORD
}

// ==================================================================================
// ====================================== VMS MODEL =================================
// ==================================================================================

model VMSScan {
  id String @id @default(cuid())

  trackingId String

  videoUrl     String?
  thumbnailUrl String?

  publicId String?
  version  Int?

  status            String @default("PENDING")
  packingScanStatus String @default("PENDING")

  fileName String?
  fileSize Int?

  duration Int?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  operatorId String?

  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  accountId String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  cameraName String?

  uploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([userId])
  @@index([operatorId])
  @@index([accountId])
}

enum ScanStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

// ==================================================================================
// ====================================== Operator MODEL ============================
// ==================================================================================

model Operator {
  id String @id @default(cuid())

  operatorName String

  employeeCode String @unique

  password String

  isActive Boolean @default(true)

  isLoggedIn Boolean @default(false)

  sessionId String?

  lastSeen DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scans VMSScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================================================================================
// ====================================== Account MODEL =============================
// ==================================================================================

model Account {
  id String @id @default(cuid())

  accountName String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vmsscans  VMSScan[]

  @@index([userId])
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique

  points Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type WalletTransactionType

  points Int

  balanceAfter Int

  description String?

  referenceId String?

  createdAt DateTime @default(now())

  @@index([walletId])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

// ==================================================================================
// ====================================== TAG LOOP MODEL ============================
// ==================================================================================

model TagLoop {
  id String @id @default(cuid())

  prefix String

  startTag String
  endTag   String

  startNumber Int
  endNumber   Int

  total Int

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([prefix])
}

// ==================================================================================
// ========================================= TAG MODEL ==============================
// ==================================================================================

model Tag {
  id String @id @default(cuid())

  tagNumber String

  status TagStatus @default(AVAILABLE)

  loopId String

  loop TagLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItemId String?

  usedAt DateTime?

  orderId String?

  createdAt DateTime @default(now())

  @@unique([userId, tagNumber])
  @@index([status])
  @@index([loopId])
}

enum TagStatus {
  AVAILABLE
  USED
}
