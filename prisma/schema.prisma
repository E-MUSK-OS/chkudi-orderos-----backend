  workspaceSuperAdminId     String   @unique
  clientName                String   @default("Enterprise Plus")
  subscriptionPlan          String   @default("Enterprise Plus")
  hasSeparateInventoryDept  Boolean  @default(false)
  enabledSections           String[] @default([])
  enabledRoutes             String[] @default([])
  configurationData         Json?
  createdById               String?
  updatedById               String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  workspaceSuperAdmin       User     @relation("WorkspaceClientConfig", fields: [workspaceSuperAdminId], references: [id], onDelete: Cascade)

  @@index([workspaceSuperAdminId])
}
