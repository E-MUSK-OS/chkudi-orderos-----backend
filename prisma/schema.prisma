generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================================================================================
// ================================ RefreshToken MODEL ==============================
// ==================================================================================

model RefreshToken {
  id String @id @default(cuid())

  token String @unique

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime

  createdAt DateTime @default(now())
}

// ==================================================================================
// ====================================== USER MODEL ================================
// ==================================================================================

model User {
  id String @id @default(cuid())

  fullName String
  username String @unique
  email    String @unique
  password String

  phone String? @db.VarChar(20)

  role Role @default(USER)

  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  isLocked     Boolean   @default(false)
  lockedAt     DateTime?
  lockedReason String?

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  refreshTokens          RefreshToken[]
  vmsscans               VMSScan[]
  operators              Operator[]
  accounts               Account[]
  wallet                 Wallet?
  tagLoops               TagLoop[]
  tags                   Tag[]
  notifications          Notification[]
  warehouses             Warehouse[]
  stockTransfers         StockTransfer[]
  products               Product[]
  materials              Material[]
  productInventories     ProductInventory[]
  skuMappings            SkuMapping[]
  sheetDrafts            SheetDraft[]
  marketplaceAccounts    MarketplaceAccount[]
  orders                 Order[]
  labelTemplates         LabelTemplate[]
  asinImports            AsinImport[]
  myntraImports          MyntraImport[]
  amazonOrders           AmazonOrder[]
  amazonProcessBatches   AmazonProcessBatch[]
  amazonAnalytics        AmazonAnalytics[]
  amazonAnalyticsSetting AmazonAnalyticsSetting?
  amazonAnalyticsHistory AmazonAnalyticsHistory[]
  amazonDailyOrderSummaries AmazonDailyOrderSummary[]
  parties                   Party[]
  salesChallans             SalesChallan[]
  purchaseChallans          PurchaseChallan[]
  webstores                 Webstore[]
  salesInvoices             SalesInvoice[]
  purchaseInvoices          PurchaseInvoice[]
  dropdownOptions           DropdownOption[]
  companies                 Company[]
  employees                 Employee[]
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

// ==================================================================================
// ================================ EMAIL OTP MODEL =================================
// ==================================================================================

model EmailOtp {
  id String @id @default(cuid())

  email String
  otp   String @db.VarChar(6)

  purpose OtpPurpose

  expiresAt DateTime

  verified Boolean @default(false)

  createdAt DateTime @default(now())
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  FORGOT_PASSWORD
}

// ==================================================================================
// ====================================== VMS MODEL =================================
// ==================================================================================

model VMSScan {
  id String @id @default(cuid())

  trackingId String

  videoUrl      String?
  thumbnailUrl  String?
  filePath      String?
  thumbnailPath String?

  publicId String?
  version  Int?

  status            String @default("PENDING")
  packingScanStatus String @default("PENDING")

  fileName String?
  fileSize Int?

  duration Int?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  operatorId String?

  operator Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  accountId String?

  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  cameraName String?

  uploadedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackingId])
  @@index([status])
  @@index([userId])
  @@index([operatorId])
  @@index([accountId])
}

enum ScanStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

// ==================================================================================
// ====================================== Operator MODEL ============================
// ==================================================================================

model Operator {
  id String @id @default(cuid())

  operatorName String

  employeeCode String @unique

  password String

  isActive Boolean @default(true)

  isLoggedIn Boolean @default(false)

  sessionId String?

  lastSeen DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  scans VMSScan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================================================================================
// ====================================== Account MODEL =============================
// ==================================================================================

model Account {
  id String @id @default(cuid())

  accountName String

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vmsscans  VMSScan[]

  @@index([userId])
}

model Wallet {
  id String @id @default(cuid())

  userId String @unique

  points Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id String @id @default(cuid())

  walletId String

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type WalletTransactionType

  points Int

  balanceAfter Int

  description String?

  referenceId String?

  createdAt DateTime @default(now())

  @@index([walletId])
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

// ==================================================================================
// ====================================== TAG LOOP MODEL ============================
// ==================================================================================

model TagLoop {
  id String @id @default(cuid())

  prefix String

  startTag String
  endTag   String

  startNumber Int
  endNumber   Int

  total Int

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags Tag[]

  notify50 Boolean @default(false)

  notify30 Boolean @default(false)

  notify10 Boolean @default(false)

  notify0 Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([prefix])
}

// ==================================================================================
// ========================================= TAG MODEL ==============================
// ==================================================================================

model Tag {
  id String @id @default(cuid())

  tagNumber String

  status TagStatus @default(AVAILABLE)

  loopId String

  loop TagLoop @relation(fields: [loopId], references: [id], onDelete: Cascade)

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orderItemId String?

  usedAt DateTime?

  orderId String?

  createdAt DateTime @default(now())

  @@unique([userId, tagNumber])
  @@index([status])
  @@index([loopId])
}

enum TagStatus {
  AVAILABLE
  USED
}

model Notification {
  id String @id @default(cuid())

  title String

  message String

  type NotificationType

  priority NotificationPriority @default(MEDIUM)

  entityId String?

  entityType String?

  status NotificationStatus @default(UNREAD)

  dismissedAt DateTime?

  readAt DateTime?

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  // @@index([isRead])
  @@index([type])
}

enum NotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum NotificationType {
  TAG_LOOP
  ORDER
  WALLET
  VMS
  INVENTORY
  SYSTEM
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ==================================================================================
// ====================================== Warehouse MODEL ===========================
// ==================================================================================

model Warehouse {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  warehouseName String
  warehouseCode String

  description String?

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  // ======================================================
  // Contact
  // ======================================================

  contactPerson String?

  phone String? @db.VarChar(20)

  email String?

  // ======================================================
  // Address
  // ======================================================

  addressLine1 String?

  addressLine2 String?

  city String?

  state String?

  country String?

  pincode String?

  // ======================================================
  // Business
  // ======================================================

  gstNumber String?

  // ======================================================
  // Relation
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  inventories  ProductInventory[]
  transferFrom StockTransfer[]    @relation("TransferFrom")

  transferTo StockTransfer[] @relation("TransferTo")

  @@unique([userId, warehouseCode])
  @@unique([userId, warehouseName])
  @@index([userId])
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StockTransfer {
  id String @id @default(cuid())

  transferNumber String

  status TransferStatus @default(PENDING)

  notes String?

  // ======================================================
  // Warehouse
  // ======================================================

  fromWarehouseId String

  toWarehouseId String

  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])

  toWarehouse Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  // ======================================================
  // User
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Items
  // ======================================================

  items StockTransferItem[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, transferNumber])
  @@index([userId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferItem {
  id String @id @default(cuid())

  transferId String

  productVariantId String

  quantity Int

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([transferId])
  @@index([productVariantId])
}

// ==================================================================================
// ====================================== PRODUCT MODEL =============================
// ==================================================================================

model Product {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  productName String
  masterSku   String
  sku         String?

  brand       String?
  category    String
  subCategory String?

  description String?

  unit            String?
  sizeList        String?
  colors          String[]
  gender          String?
  referenceParty  String?
  marketplace     String?  @default("All")

  productCost       Float?
  dealerRate        Float?
  retailRate        Float?
  openingStock      Int?
  reorderLevelStock Int?
  minimumStock      Int?
  productPoints     Float?
  isPaired          Boolean @default(false)
  availability      String?

  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  mrp             String?
  mfgMonth        String?
  hsnCode         String?
  gstRate         Float?
  imageUrl        String?

  imgfileurl      String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  // ======================================================
  // Relations
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attributes ProductAttribute[]

  variants ProductVariant[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, masterSku])
  @@unique([userId, productName])
  @@index([userId])
  @@index([category])
  @@index([brand])
  @@index([asin])
}

model ProductAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Attribute
  // ======================================================

  attributeName String

  // ======================================================
  // Relation
  // ======================================================

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantAttributes ProductVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, attributeName])
  @@index([productId])
}

// ==================================================================================
// =============================== PRODUCT VARIANT MODEL ============================
// ==================================================================================

model ProductVariant {
  id String @id @default(cuid())

  // ======================================================
  // Variant
  // ======================================================

  variantSku      String
  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  imageUrl        String?

  imgfileurl      String?

  isActive Boolean @default(true)

  // ======================================================
  // Relation
  // ======================================================

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes ProductVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  // inventory ProductInventory?
  inventories        ProductInventory[]
  stockTransferItems StockTransferItem[]
  orderItems         OrderItem[]

  @@unique([productId, variantSku])
  @@index([productId])
}

// ==================================================================================
// ========================= PRODUCT VARIANT ATTRIBUTE MODEL ========================
// ==================================================================================

model ProductVariantAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Value
  // ======================================================

  attributeValue String

  // ======================================================
  // Relations
  // ======================================================

  productVariantId String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  productAttributeId String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productVariantId, productAttributeId])
  @@index([productVariantId])
  @@index([productAttributeId])
}

// ==================================================================================
// ====================================== MATERIAL MODEL =============================
// ==================================================================================

model Material {
  id String @id @default(cuid())

  // ======================================================
  // Basic
  // ======================================================

  materialName String
  masterSku    String
  sku          String?

  brand              String?
  category           String
  manufacturingGroup String?
  subCategory        String?
  forUse             String?

  description String?

  unit           String?
  sizeList       String?
  colors         String[]
  width          Float?   @default(0)
  widthRangeFrom Float?   @default(0)
  widthRangeTo   Float?   @default(0)
  gsm            Float?   @default(0)
  gsmRangeFrom   Float?   @default(0)
  gsmRangeTo     Float?   @default(0)
  ledgerGroup    String?  @default("Material Purchase")
  less           Float?   @default(0)
  gender         String?
  referenceParty String?
  marketplace    String?  @default("All")

  costApplyingMode         String?
  materialCost             Float?
  salesRate                Float?   @default(0)
  purchaseType             String?
  isStockDetailsCompulsory Boolean  @default(false)
  issueMode                String?
  consumptionMode          String?
  isIssuable               Boolean  @default(false)
  isSellable               Boolean  @default(false)

  dealerRate        Float?
  retailRate        Float?
  openingStock      Int?
  reorderLevelStock Int?
  minimumStock      Int?
  materialPoints    Float?
  isPaired          Boolean @default(false)
  availability      String?

  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  mrp             String?
  mfgMonth        String?
  hsnCode         String?
  gstRate         Float?
  imageUrl        String?

  imgfileurl      String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  // ======================================================
  // Relations
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  attributes MaterialAttribute[]

  variants MaterialVariant[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, masterSku])
  @@unique([userId, materialName])
  @@index([userId])
  @@index([category])
  @@index([brand])
  @@index([asin])
}

model MaterialAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Attribute
  // ======================================================

  attributeName String

  // ======================================================
  // Relation
  // ======================================================

  materialId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  variantAttributes MaterialVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, attributeName])
  @@index([materialId])
}

// ==================================================================================
// =============================== MATERIAL VARIANT MODEL ============================
// ==================================================================================

model MaterialVariant {
  id String @id @default(cuid())

  // ======================================================
  // Variant
  // ======================================================

  variantSku      String
  asin            String?
  rackAddress     String?
  generateBarcode String? @default("No")
  imageUrl        String?

  imgfileurl      String?

  isActive Boolean @default(true)

  // ======================================================
  // Relation
  // ======================================================

  materialId String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  attributes MaterialVariantAttribute[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, variantSku])
  @@index([materialId])
}

// ==================================================================================
// ========================= MATERIAL VARIANT ATTRIBUTE MODEL ========================
// ==================================================================================

model MaterialVariantAttribute {
  id String @id @default(cuid())

  // ======================================================
  // Value
  // ======================================================

  attributeValue String

  // ======================================================
  // Relations
  // ======================================================

  materialVariantId String

  materialVariant MaterialVariant @relation(fields: [materialVariantId], references: [id], onDelete: Cascade)

  materialAttributeId String

  materialAttribute MaterialAttribute @relation(fields: [materialAttributeId], references: [id], onDelete: Cascade)

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialVariantId, materialAttributeId])
  @@index([materialVariantId])
  @@index([materialAttributeId])
}

model ProductInventory {
  id String @id @default(cuid())

  // ======================================================
  // Relations
  // ======================================================

  // productVariantId String @unique
  productVariantId String
  warehouseId      String
  userId           String

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // Stock
  // ======================================================

  availableStock Int @default(0)
  reservedStock  Int @default(0)
  damagedStock   Int @default(0)
  incomingStock  Int @default(0)
  reorderLevel   Int @default(10)

  // ===============================
  // Notification Flags
  // ===============================

  // lowStock25Notified Boolean @default(false)

  // lowStock10Notified Boolean @default(false)

  // outOfStockNotified Boolean @default(false)
  lastNotificationLevel Int?

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  // warehouseId String?

  @@unique([productVariantId, warehouseId])
  @@index([userId])
  @@index([availableStock])
}

// ==================================================================================
// ============================== SKU MAPPING MODEL =================================
// ==================================================================================

model SkuMapping {
  id String @id @default(cuid())

  // ======================================================
  // User
  // ======================================================

  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ======================================================
  // SKU Mapping
  // ======================================================

  // Required
  shortSku   String
  barcodeSku String

  // Optional
  ordercookSku String?
  brandName    String?
  asinBarcode  String?
  color        String?
  size         String?
  fullSku      String?
  title        String?
  qty          Int?
  mrp          String?
  mfgMonth     String?

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, shortSku])
  @@index([userId])
  @@index([shortSku])
}

model SheetDraft {
  id String @id @default(cuid())

  userId String
  rows   Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
}

// ==================================================================================
// ============================== MARKETPLACE MODEL =================================
// ==================================================================================

model Marketplace {
  id String @id @default(cuid())

  marketplaceName String

  marketplaceCode String @unique

  description String?

  displayOrder Int @default(0)

  isActive Boolean @default(true)

  marketplaceAccounts MarketplaceAccount[] @relation("MarketplaceToAccount")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([marketplaceCode])
}

// ==================================================================================
// ========================== MARKETPLACE ACCOUNT MODEL ==============================
// ==================================================================================

model MarketplaceAccount {
  id String @id @default(cuid())

  // ======================================================
  // Relations
  // ======================================================

  userId String

  marketplaceId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketplace Marketplace @relation("MarketplaceToAccount", fields: [marketplaceId], references: [id])

  // ======================================================
  // Seller Information
  // ======================================================

  sellerName String @db.VarChar(150)

  sellerCode String @db.VarChar(100)

  displayName String?

  // ======================================================
  // Status
  // ======================================================

  isActive Boolean @default(true)

  connectionStatus MarketplaceConnectionStatus @default(NOT_CONNECTED)
  connection       MarketplaceConnection?
  orders           Order[]

  // ======================================================
  // System
  // ======================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([userId, marketplaceId, sellerCode])
  @@index([userId])
  @@index([marketplaceId])
}

enum MarketplaceConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  CONNECTED
  FAILED
}

model MarketplaceConnection {
  id String @id @default(cuid())

  marketplaceAccountId String @unique

  marketplaceAccount MarketplaceAccount @relation(fields: [marketplaceAccountId], references: [id], onDelete: Cascade)

  credentials Json

  environment MarketplaceEnvironment @default(PRODUCTION)

  status MarketplaceConnectionStatus @default(NOT_CONNECTED)

  lastConnectedAt DateTime?

  lastSyncAt DateTime?

  lastError String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum MarketplaceEnvironment {
  SANDBOX
  PRODUCTION
}

// ==================================================================================
// =================================== ORDER MODELS =================================
// ==================================================================================

model Order {
  id String @id @default(cuid())

  orderNumber String

  channelOrderId String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketplaceAccountId String?
  marketplaceAccount   MarketplaceAccount? @relation(fields: [marketplaceAccountId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String?
  customerPhone String? @db.VarChar(20)

  shippingAddress String?

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMethod String?

  totalAmount Float @default(0)

  shippingAmount Float @default(0)

  discountAmount Float @default(0)

  courierName String?

  trackingId String?

  notes String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, orderNumber])
  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([channelOrderId])
  @@index([trackingId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  productName String

  sku String

  quantity Int @default(1)

  unitPrice Float @default(0)

  totalPrice Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productVariantId])
  @@index([sku])
}

enum OrderStatus {
  PENDING
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ==================================================================================
// ============================= LABEL TEMPLATE MODEL ===============================
// ==================================================================================

model LabelTemplate {
  id String @id @default(cuid())

  name               String
  marketplaceId      String?
  backgroundImageUrl String?
  thumbnailUrl       String?

  layoutJson Json
  settings   Json

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ==================================================================================
// ============================= ASIN IMPORT MODEL ==================================
// ==================================================================================

model AsinImport {
  id String @id @default(cuid())

  asin            String
  sku             String
  generateBarcode String?
  rackAddress     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([asin])
  @@index([sku])
}

// ==================================================================================
// ============================ MYNTRA IMPORT MODEL ================================
// ==================================================================================
model MyntraImport {
