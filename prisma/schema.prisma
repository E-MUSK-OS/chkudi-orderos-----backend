  considerInPnL         String?       @default("Yes")

  // Logo & Signature
  logoUrl               String?
  signatureUrl          String?
  completionPercentage  Int?          @default(60)

  status                String        @default("ACTIVE") // ACTIVE, DRAFT, INACTIVE
  isDefault             Boolean       @default(false)

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
  @@index([gstNumber])
  @@index([status])
}





// ==================================================================================
// ================================ EMPLOYEE MODEL ==================================
// ==================================================================================

model Employee {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identification & Names
  firstName         String
  middleName        String?
  lastName          String
  fullName          String
  employeeId        String
  machineCode       String?
  loginId           String?
  email             String?
  contactNo         String
  aadhaarNo         String?

  // Personal & Organization
  dob               DateTime?
  bloodGroup        String?
  branch            String?
  department        String
  designation       String
  salaryType        String?   @default("Salaried")
  joiningDate       DateTime?
  workerProcess     String?

  // Contact Details & Address
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  country           String?   @default("India")
  pincode           String?

  // Bank Details
  accountNumber     String?
  accountHolderName String?
  bankName          String?
  branchName        String?
  accountType       String?
  ifscCode          String?

  // Media / Documents URLs
  photoUrl          String?
  identityDocUrl    String?
  bankDocUrl        String?
  documents         Json?     @default("[]")

  // Status & Meta
  isActive          Boolean   @default(true)
  createdByName     String?
  updatedByName     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Salary & Working Details
  basicSalary           Float     @default(0.0)
  workingDayMode        String?   @default("Monthly")
  workingDays           Int?      @default(31)
  workingHoursPerDay    Float?    @default(8.0)
  totalHours            Float?    @default(248.0)
  wageRate              Float?    @default(0.0)
  otRatePercent         Float?    @default(0.0)
  otRatePerHour         Float?    @default(0.0)
  transportAllowance    Float?    @default(0.0)
  medicalAllowance      Float?    @default(0.0)

  // Relations
  absentRecords         EmployeeAbsentRecord[]

  @@index([userId])
  @@index([employeeId])
  @@index([contactNo])
  @@index([department])
}

// ==================================================================================
// ========================= EMPLOYEE ABSENT RECORD MODEL ===========================
// ==================================================================================

model EmployeeAbsentRecord {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  financialYear   String    @default("2026-2027")
  monthName       String    // e.g. "April 2026", "May 2026"
  monthIndex      Int       @default(0) // 0 for April ... 11 for March

  periodStartDate DateTime?
  periodEndDate   DateTime?
  periodString    String?   // e.g. "01-04-2026 - 15-04-2026"

  absentHours     Float     @default(0.0)
  overtimeHours   Float     @default(0.0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId])
  @@index([financialYear])
}
